{
  "name": "FTC WA Event Assignment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [5055],
  "portsAttributes": {
    "5055": {
      "label": "OSRM (optional routing)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq osmium-tool && pip install -r requirements.txt && bash setup.sh",
  "waitFor": "postCreateCommand"
}
